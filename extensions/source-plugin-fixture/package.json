{
  "name": "source-plugin-fixture",
  "displayName": "Browser2IDE Source Plugin Fixture",
  "publisher": "browser2ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.cjs",
  "extensionDependencies": [
    "browser2ide.browser2ide-vscode"
  ],
  "activationEvents": [
    "onLanguage:browser2ide-fixture"
  ],
  "contributes": {
    "languages": [
      {
        "id": "browser2ide-fixture",
        "extensions": [".b2i"]
      }
    ]
  },
  "scripts": {
    "build": "pnpm run typecheck && node ./esbuild.mjs",
    "test": "pnpm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@browser2ide/plugin-api": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.0"
  }
}
