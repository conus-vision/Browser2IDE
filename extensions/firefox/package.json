{
  "name": "browser2ide-firefox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter @browser2ide/protocol build && pnpm --filter @browser2ide/browser-extension-core build",
    "build": "pnpm run build:deps && tsc --noEmit -p tsconfig.json && node ./esbuild.mjs",
    "test": "pnpm run build:deps && vitest run",
    "typecheck": "pnpm run build:deps && tsc --noEmit -p tsconfig.json",
    "lint": "pnpm run build:deps && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@browser2ide/browser-extension-core": "workspace:*",
    "@browser2ide/protocol": "workspace:*",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "^0.12.5",
    "esbuild": "^0.21.5",
    "vitest": "^2.1.0"
  }
}
